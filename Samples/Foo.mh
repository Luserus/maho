namespace Std;

using int64 = Std.Int64;
using str8 = Std.String8;
using char8 = Std.Char8;

public intrinsic attribute Intrinsic(str8 TypeName);

[Intrinsic("ValType")]
public struct ValType;

[Intrinsic("Int32")]
public struct Int32 : ValType;

[Intrinsic("Int64")]
public struct Int64 : ValType;

[Intrinsic("Float32")]
public struct Float32 : ValType;

[Intrinsic("Char8")]
public struct Char8 : ValType;

public struct Span<T>
{
    private T* memory;
    
    public int64 Length { get; }
}

[Intrinsic("String8")]
public struct String8 : ValType
{
    public int64 Length { get; }

    private Span<char8> string;
}