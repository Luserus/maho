#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI_PROJECT="$REPO_ROOT/src/MahoCli/MahoCli.csproj"
SERVER_HOST_PROJECT="$REPO_ROOT/src/MahoServerHost/MahoServerHost.csproj"
SERVER_PROJECT="$REPO_ROOT/src/MahoServer/MahoServer.csproj"
COMPILER_PROJECT="$REPO_ROOT/src/Maho/Maho.csproj"
MIRYO_PROJECT="$REPO_ROOT/src/Miryo/Miryo.csproj"
MIRYO_UPDATE_PROJECT="$REPO_ROOT/src/MiryoUpdate/MiryoUpdate.csproj"
DIST_DIR="$REPO_ROOT/dist"
CLI_VERSION="$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' "$CLI_PROJECT" | tr -d ' \r' | head -n 1)"
CLI_VERSION="${CLI_VERSION:-0.2.0}"

# Find dotnet executable
DOTNET_BIN="$(which dotnet 2>/dev/null || true)"
if [ -z "$DOTNET_BIN" ] && [ -x "/home/luserus/Runtimes/dotnet/dotnet" ]; then
    DOTNET_BIN="/home/luserus/Runtimes/dotnet/dotnet"
fi
DOTNET_BIN="${DOTNET_BIN:-dotnet}"

show_help() {
    cat <<EOF
Usage: ./build-maho [options]

Build script for the Maho toolchain (miryo, mahoc, Maho).

Options:
  --all, all                     Build toolchain for all major platforms (linux-x64, linux-arm64, win-x64, osx-x64, osx-arm64)
  --platform, -p <platform>      Build toolchain for a specific platform (e.g. linux-arm64, win-x64, osx-arm64)
  --single-file, -s, single      Produce standalone distribution package using shared runtime in dist/runtime
  --debug, -d                    Build with debug configuration and emit PDB symbol files
  --install, -i                  Install built toolchain to ~/.maho/
  -h, --help                     Show this help message

Default behavior:
  Fast incremental publishing for testing (framework-dependent),
  omitting PDB symbols and dependency JSON files.
EOF
}

detect_host_rid() {
    local os arch
    case "$(uname -s)" in
        Linux*)  os="linux" ;;
        Darwin*) os="osx" ;;
        CYGWIN*|MINGW*|MSYS*) os="win" ;;
        *)       os="linux" ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch="x64" ;;
        arm64|aarch64) arch="arm64" ;;
        *)            arch="x64" ;;
    esac
    echo "${os}-${arch}"
}

normalize_rid() {
    local input="$1"
    case "$input" in
        win|windows)             echo "win-x64" ;;
        windows-x64|win64)       echo "win-x64" ;;
        windows-arm64)           echo "win-arm64" ;;
        linux)                   echo "linux-x64" ;;
        linux-aarch64)           echo "linux-arm64" ;;
        osx|mac|macos)           echo "osx-x64" ;;
        macos-x64|mac-x64)       echo "osx-x64" ;;
        macos-arm64|mac-arm64)   echo "osx-arm64" ;;
        *)                       echo "$input" ;;
    esac
}

build_all=false
target_platform=""
single_file=false
debug_mode=false
install_to_home=false

while [ $# -gt 0 ]; do
    case "$1" in
        --all|all)
            build_all=true
            shift
            ;;
        --platform|-p|platform)
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: --platform requires a platform argument (e.g. linux-arm64, win-x64, osx-arm64)" >&2
                exit 1
            fi
            target_platform="$2"
            shift 2
            ;;
        --platform=*|-p=*)
            target_platform="${1#*=}"
            shift
            ;;
        --single-file|-s|single)
            single_file=true
            shift
            ;;
        --debug|-d|debug)
            debug_mode=true
            shift
            ;;
        --install|-i|install)
            install_to_home=true
            shift
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown argument '$1'" >&2
            echo "" >&2
            show_help >&2
            exit 1
            ;;
    esac
done

if [ "$build_all" = true ] && [ -n "$target_platform" ]; then
    echo "Error: Cannot specify both --all and --platform" >&2
    exit 1
fi

if [ -n "$target_platform" ]; then
    target_platform="$(normalize_rid "$target_platform")"
fi

config="Release"
debug_props=("-p:DebugType=None" "-p:GenerateDependencyFile=false")

if [ "$debug_mode" = true ]; then
    config="Debug"
    debug_props=("-p:DebugType=portable" "-p:GenerateDependencyFile=true")
fi

publish_target() {
    local rid="$1"
    local out_dir="$2"
    local tool_version
    tool_version="$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' "$CLI_PROJECT" | tr -d ' \r' | head -n 1)"
    tool_version="${tool_version:-0.2.0}"
    local miryo_version
    miryo_version="$(sed -n 's:.*<Version>\(.*\)</Version>.*:\1:p' "$MIRYO_PROJECT" | tr -d ' \r' | head -n 1)"
    miryo_version="${miryo_version:-1.0.0}"

    local bin_args=("${debug_props[@]}")
    local tools_args=("${debug_props[@]}")

    if [ "$single_file" = true ]; then
        bin_args+=("-r" "$rid" "--no-self-contained" "-p:PublishSingleFile=true" "-p:AppHostRelativeDotNet=../runtime")
        tools_args+=("-r" "$rid" "--no-self-contained" "-p:PublishSingleFile=true" "-p:AppHostRelativeDotNet=../../runtime")
    elif [ -n "$rid" ]; then
        bin_args+=("-r" "$rid" "--no-self-contained")
        tools_args+=("-r" "$rid" "--no-self-contained")
    fi

    local bin_dir="$out_dir/bin"
    local tools_dir="$out_dir/tools/$tool_version"
    local shims_dir="$out_dir/shims"
    local compiler_dir="$out_dir/compiler/$tool_version"
    local runtime_dir="$out_dir/runtime"

    mkdir -p "$bin_dir" "$tools_dir" "$shims_dir" "$compiler_dir"

    # 1. Publish bin tools: miryo and miryo-update
    "$DOTNET_BIN" publish "$MIRYO_PROJECT" -c "$config" -o "$bin_dir" "${bin_args[@]}" --nologo -v q
    "$DOTNET_BIN" publish "$MIRYO_UPDATE_PROJECT" -c "$config" -o "$bin_dir" "${bin_args[@]}" --nologo -v q
    cat > "$bin_dir/manifest.json" <<EOF
{
  "version": "$miryo_version",
  "miryo": "miryo",
  "miryoUpdate": "miryo-update",
  "channel": "stable"
}
EOF

    # 2. Publish versioned tools: mahoc and maho-server
    "$DOTNET_BIN" publish "$CLI_PROJECT" -c "$config" -o "$tools_dir" "${tools_args[@]}" --nologo -v q
    "$DOTNET_BIN" publish "$SERVER_HOST_PROJECT" -c "$config" -o "$tools_dir" "${tools_args[@]}" --nologo -v q

    # Create placeholder maho-ls
    if [[ "$rid" == win-* ]]; then
        cat > "$tools_dir/maho-ls.cmd" <<'EOF'
@echo maho-ls language server is not yet implemented.
@exit /b 1
EOF
    else
        cat > "$tools_dir/maho-ls" <<'EOF'
#!/usr/bin/env sh
echo "maho-ls language server is not yet implemented." >&2
exit 1
EOF
        chmod +x "$tools_dir/maho-ls"
    fi

    cat > "$tools_dir/manifest.json" <<EOF
{
  "version": "$tool_version",
  "targetCompilerVersion": "$tool_version",
  "tools": {
    "mahoc": "mahoc",
    "maho-server": "maho-server",
    "maho-ls": "maho-ls"
  }
}
EOF

    # 3. Publish compiler library: Maho.dll
    "$DOTNET_BIN" publish "$COMPILER_PROJECT" -c "$config" -o "$compiler_dir" "${debug_props[@]}" --nologo -v q
    cat > "$compiler_dir/manifest.json" <<EOF
{
  "version": "$tool_version",
  "assembly": "Maho.dll"
}
EOF

    # 4. If in distribution mode (-s), deploy shared runtime to $runtime_dir
    if [ "$single_file" = true ]; then
        echo "    -> Deploying shared runtime into $runtime_dir..."
        mkdir -p "$runtime_dir/shared"

        local dotnet_dir
        dotnet_dir="$(cd -- "$(dirname -- "$DOTNET_BIN")" && pwd)"

        if [ -d "$dotnet_dir/host" ]; then
            cp -r "$dotnet_dir/host" "$runtime_dir/"
        fi

        if [ -d "$dotnet_dir/shared/Microsoft.NETCore.App" ]; then
            cp -r "$dotnet_dir/shared/Microsoft.NETCore.App" "$runtime_dir/shared/"
        fi

        if [ -f "$dotnet_dir/dotnet" ]; then
            cp "$dotnet_dir/dotnet" "$runtime_dir/"
        elif [ -f "$dotnet_dir/dotnet.exe" ]; then
            cp "$dotnet_dir/dotnet.exe" "$runtime_dir/"
        fi
    fi

    # 5. Publish server component: MahoServer.dll into server/
    local server_dir="$out_dir/server"
    mkdir -p "$server_dir"
    "$DOTNET_BIN" publish "$SERVER_PROJECT" -c "$config" -o "$server_dir" "${debug_props[@]}" --nologo -v q
    cat > "$server_dir/manifest.json" <<EOF
{
  "activeCompilerVersion": "$tool_version",
  "installedTools": ["$tool_version"],
  "installedCompilers": ["$tool_version"]
}
EOF

    # 6. Generate shims in shims/
    if [[ "$rid" == win-* ]]; then
        cat > "$shims_dir/mahoc.cmd" <<EOF
@"%~dp0..\tools\\$tool_version\mahoc.exe" %*
EOF
        cat > "$shims_dir/maho-server.cmd" <<EOF
@"%~dp0..\tools\\$tool_version\maho-server.exe" %*
EOF
        cat > "$shims_dir/maho-ls.cmd" <<EOF
@"%~dp0..\tools\\$tool_version\maho-ls.cmd" %*
EOF
    else
        ln -sf "../tools/$tool_version/mahoc" "$shims_dir/mahoc"
        ln -sf "../tools/$tool_version/maho-server" "$shims_dir/maho-server"
        ln -sf "../tools/$tool_version/maho-ls" "$shims_dir/maho-ls"
    fi

    # 7. Generate miryo.config inside bin/ folder alongside miryo
    cat > "$bin_dir/miryo.config" <<EOF
# Miryo Toolchain Configuration

[tools]
mahoc = ["../tools/$tool_version/mahoc", "../shims/mahoc", "mahoc"]
mahoc_server = ["../tools/$tool_version/maho-server", "../shims/maho-server", "maho-server"]
mahoc_compiler = ["../compiler/$tool_version"]

[templates]
bin_template = "EntryFile : \"src/Program.mh\";\nImplicitTopLevel : true;\n"
lib_template = "EntryFile : \"src/Lib.mh\";\nImplicitTopLevel : false;\n"
bin_source_path = "src/Program.mh"
bin_source = "println(\"Hello from Maho!\");\n"
lib_source_path = "src/Lib.mh"
lib_source = "public struct Lib;\n"
gitignore = "target/\nbin/\nobj/\ndist/\n"
EOF
}

find_binary() {
    local dir="$1"
    local name="$2"
    if [[ -f "$dir/$name" ]]; then
        echo "$dir/$name"
    elif [[ -f "$dir/$name.exe" ]]; then
        echo "$dir/$name.exe"
    else
        echo "$dir/$name"
    fi
}

host_rid="$(detect_host_rid)"

if [ "$build_all" = true ]; then
    platforms=("linux-x64" "linux-arm64" "win-x64" "osx-x64" "osx-arm64")

    echo "==> Building Maho toolchain for all major platforms..."
    mkdir -p "$DIST_DIR"

    for rid in "${platforms[@]}"; do
        echo "  -> Publishing for $rid..."
        mkdir -p "$DIST_DIR/$rid"
        publish_target "$rid" "$DIST_DIR/$rid"
    done

    echo "  -> Publishing for host platform into $DIST_DIR..."
    publish_target "$host_rid" "$DIST_DIR"

    host_miryo="$(find_binary "$DIST_DIR/bin" "miryo")"
    host_mahoc="$(find_binary "$DIST_DIR/tools/$CLI_VERSION" "mahoc")"
    host_server="$(find_binary "$DIST_DIR/tools/$CLI_VERSION" "maho-server")"

    echo ""
    echo "Maho toolchain successfully built for all major platforms:"
    echo "  Host Toolchain Manager (miryo): $host_miryo"
    echo "  Host Compiler (mahoc):          $host_mahoc"
    echo "  Host Server (maho-server):      $host_server"
elif [ -n "$target_platform" ]; then
    echo "==> Building Maho toolchain for platform '$target_platform'..."
    target_dir="$DIST_DIR/$target_platform"
    mkdir -p "$target_dir"
    publish_target "$target_platform" "$target_dir"

    miryo_bin="$(find_binary "$target_dir/bin" "miryo")"
    mahoc_bin="$(find_binary "$target_dir/tools/$CLI_VERSION" "mahoc")"
    server_bin="$(find_binary "$target_dir/tools/$CLI_VERSION" "maho-server")"

    echo ""
    echo "Maho toolchain successfully built for $target_platform:"
    echo "  miryo:       $miryo_bin"
    echo "  mahoc:       $mahoc_bin"
    echo "  maho-server: $server_bin"
else
    echo "==> Building Maho toolchain for host platform ($host_rid)..."
    mkdir -p "$DIST_DIR"

    publish_target "$host_rid" "$DIST_DIR"

    miryo_bin="$(find_binary "$DIST_DIR/bin" "miryo")"
    mahoc_bin="$(find_binary "$DIST_DIR/tools/$CLI_VERSION" "mahoc")"
    server_bin="$(find_binary "$DIST_DIR/tools/$CLI_VERSION" "maho-server")"

    echo ""
    echo "Maho toolchain successfully built:"
    echo "  miryo:       $miryo_bin"
    echo "  mahoc:       $mahoc_bin"
    echo "  maho-server: $server_bin"
    echo "  Layout:      $DIST_DIR"
fi

if [ "$install_to_home" = true ]; then
    target_home="${MAHO_HOME:-$HOME/.maho}"
    echo ""
    echo "==> Installing Maho toolchain to $target_home..."
    mkdir -p "$target_home"
    cp -r "$DIST_DIR"/* "$target_home/"
    echo "Installation complete!"
    echo "Add '$target_home/bin' and '$target_home/shims' to your PATH to use miryo and mahoc directly."
fi
