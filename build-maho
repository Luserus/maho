#!/usr/bin/env bash

set -euo pipefail

REPO_ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CLI_PROJECT="$REPO_ROOT/src/MahoCli/MahoCli.csproj"
MIRYO_PROJECT="$REPO_ROOT/src/Miryo/Miryo.csproj"
MAHO_PROJECT="$REPO_ROOT/src/Maho/Maho.csproj"
DIST_DIR="$REPO_ROOT/dist"

show_help() {
    cat <<EOF
Usage: ./build-maho [options]

Build script for the Maho toolchain (miryo, mahoc, Maho).

Options:
  --all, all                     Build toolchain for all major platforms (linux-x64, linux-arm64, win-x64, osx-x64, osx-arm64)
  --platform, -p <platform>      Build toolchain for a specific platform (e.g. linux-arm64, win-x64, osx-arm64)
  --single-file, -s              Produce fast, single-file decoupled binaries (framework-dependent, no loose DLLs)
  --self-contained, -sc          Produce standalone self-contained, single-file, trimmed executables
  --debug, -d                    Build with debug configuration and emit PDB symbol files
  -h, --help                     Show this help message

Default behavior:
  Builds host platform toolchain into dist/ with Release configuration,
  omitting PDB symbols and dependency JSON files.
EOF
}

detect_host_rid() {
    local os arch
    case "$(uname -s)" in
        Linux*)  os="linux" ;;
        Darwin*) os="osx" ;;
        CYGWIN*|MINGW*|MSYS*) os="win" ;;
        *)       os="linux" ;;
    esac
    case "$(uname -m)" in
        x86_64|amd64) arch="x64" ;;
        arm64|aarch64) arch="arm64" ;;
        *)            arch="x64" ;;
    esac
    echo "${os}-${arch}"
}

normalize_rid() {
    local input="$1"
    case "$input" in
        win|windows)             echo "win-x64" ;;
        windows-x64|win64)       echo "win-x64" ;;
        windows-arm64)           echo "win-arm64" ;;
        linux)                   echo "linux-x64" ;;
        linux-aarch64)           echo "linux-arm64" ;;
        osx|mac|macos)           echo "osx-x64" ;;
        macos-x64|mac-x64)       echo "osx-x64" ;;
        macos-arm64|mac-arm64)   echo "osx-arm64" ;;
        *)                       echo "$input" ;;
    esac
}

build_all=false
target_platform=""
single_file=false
self_contained=false
debug_mode=false

while [ $# -gt 0 ]; do
    case "$1" in
        --all|all)
            build_all=true
            shift
            ;;
        --platform|-p|platform)
            if [ $# -lt 2 ] || [[ "$2" == -* ]]; then
                echo "Error: --platform requires a platform argument (e.g. linux-arm64, win-x64, osx-arm64)" >&2
                exit 1
            fi
            target_platform="$2"
            shift 2
            ;;
        --platform=*|-p=*)
            target_platform="${1#*=}"
            shift
            ;;
        --self-contained|-sc|self-contained)
            self_contained=true
            single_file=true
            shift
            ;;
        --single-file|-s|single)
            single_file=true
            shift
            ;;
        --debug|-d|debug)
            debug_mode=true
            shift
            ;;
        -h|--help|help)
            show_help
            exit 0
            ;;
        *)
            echo "Error: Unknown argument '$1'" >&2
            echo "" >&2
            show_help >&2
            exit 1
            ;;
    esac
done

if [ "$build_all" = true ] && [ -n "$target_platform" ]; then
    echo "Error: Cannot specify both --all and --platform" >&2
    exit 1
fi

if [ -n "$target_platform" ]; then
    target_platform="$(normalize_rid "$target_platform")"
fi

config="Release"
debug_props=("-p:DebugType=None" "-p:GenerateDependencyFile=false")

if [ "$debug_mode" = true ]; then
    config="Debug"
    debug_props=("-p:DebugType=portable" "-p:GenerateDependencyFile=true")
fi

publish_target() {
    local rid="$1"
    local out_dir="$2"
    local exe_args=("${debug_props[@]}")

    if [ "$self_contained" = true ]; then
        exe_args+=("-r" "$rid" "--self-contained" "-p:PublishSingleFile=true" "-p:PublishTrimmed=true")
    elif [ "$single_file" = true ]; then
        exe_args+=("-r" "$rid" "--no-self-contained" "-p:PublishSingleFile=true")
    elif [ -n "$rid" ]; then
        exe_args+=("-r" "$rid" "--no-self-contained")
    fi

    # 1. Publish mahoc
    dotnet publish "$CLI_PROJECT" -c "$config" -o "$out_dir" "${exe_args[@]}" --nologo -v q

    # 2. Publish miryo
    dotnet publish "$MIRYO_PROJECT" -c "$config" -o "$out_dir" "${exe_args[@]}" --nologo -v q

    # 3. Publish Maho library
    dotnet publish "$MAHO_PROJECT" -c "$config" -o "$out_dir" "${debug_props[@]}" --nologo -v q

    # 4. Generate miryo.config
    cat > "$out_dir/miryo.config" <<'EOF'
# Miryo Toolchain Configuration

[tools]
mahoc = ["./mahoc", "mahoc"]
il2llvmir = ["./il2llvmir", "il2llvmir"]
llvm_opt = ["opt", "/usr/bin/opt"]
llvm_clang = ["clang", "/usr/bin/clang"]

[templates]
bin_template = "EntryFile : \"src/Program.mh\";\nImplicitTopLevel : true;\n"
lib_template = "EntryFile : \"src/Lib.mh\";\nImplicitTopLevel : false;\n"
bin_source_path = "src/Program.mh"
bin_source = "println(\"Hello from Maho!\");\n"
lib_source_path = "src/Lib.mh"
lib_source = "public struct Lib;\n"
gitignore = "target/\nbin/\nobj/\ndist/\n"
EOF
}

find_binary() {
    local dir="$1"
    local name="$2"
    if [[ -f "$dir/$name" ]]; then
        echo "$dir/$name"
    elif [[ -f "$dir/$name.exe" ]]; then
        echo "$dir/$name.exe"
    else
        echo "$dir/$name"
    fi
}

host_rid="$(detect_host_rid)"

if [ "$build_all" = true ]; then
    platforms=("linux-x64" "linux-arm64" "win-x64" "osx-x64" "osx-arm64")

    echo "==> Building Maho toolchain for all major platforms..."
    mkdir -p "$DIST_DIR"

    for rid in "${platforms[@]}"; do
        echo "  -> Publishing for $rid..."
        mkdir -p "$DIST_DIR/$rid"
        publish_target "$rid" "$DIST_DIR/$rid"
    done

    echo "  -> Publishing for host platform into $DIST_DIR..."
    if [ "$single_file" = true ]; then
        publish_target "$host_rid" "$DIST_DIR"
    else
        publish_target "$host_rid" "$DIST_DIR"
    fi

    host_mahoc="$(find_binary "$DIST_DIR" "mahoc")"
    host_miryo="$(find_binary "$DIST_DIR" "miryo")"

    echo ""
    echo "Maho toolchain successfully built for all major platforms:"
    echo "  Host Compiler (mahoc): $host_mahoc"
    echo "  Host Project (miryo):  $host_miryo"
    echo ""
    echo "Execute host toolchain via:"
    echo "  $host_miryo [command] [options]"
    echo "  $host_mahoc [options] [source-paths...]"
elif [ -n "$target_platform" ]; then
    echo "==> Building Maho toolchain for platform '$target_platform'..."
    target_dir="$DIST_DIR/$target_platform"
    mkdir -p "$target_dir"
    publish_target "$target_platform" "$target_dir"

    mahoc_bin="$(find_binary "$target_dir" "mahoc")"
    miryo_bin="$(find_binary "$target_dir" "miryo")"

    echo ""
    echo "Maho toolchain successfully built for $target_platform:"
    echo "  mahoc: $mahoc_bin"
    echo "  miryo: $miryo_bin"
    echo ""
    if [ "$target_platform" = "$host_rid" ]; then
        echo "Execute toolchain via:"
        echo "  $miryo_bin [command] [options]"
        echo "  $mahoc_bin [options] [source-paths...]"
    fi
else
    echo "==> Building Maho toolchain for host platform ($host_rid)..."
    mkdir -p "$DIST_DIR"

    publish_target "$host_rid" "$DIST_DIR"

    mahoc_bin="$(find_binary "$DIST_DIR" "mahoc")"
    miryo_bin="$(find_binary "$DIST_DIR" "miryo")"

    echo ""
    echo "Maho toolchain successfully built:"
    echo "  mahoc:         $mahoc_bin"
    echo "  miryo:         $miryo_bin"
    echo "  Core Library:  $DIST_DIR/Maho.dll"
    echo "  Configuration: $DIST_DIR/miryo.config"
    echo ""
    echo "Execute toolchain via:"
    echo "  $miryo_bin [command] [options]"
    echo "  $mahoc_bin [options] [source-paths...]"
fi
